#include <stdio.h>

struct Book {
    int id;
    char title[50];
    char author[50];
    int available;
};

struct Book books[50];
int count = 3;
void addBook() {
    if (count == 50) {
        printf("\nLibrary is full!\n");
        return;
    }

    books[count].id = count + 1;

    printf("Enter book title: ");
    scanf(" %49[^\n]", books[count].title);

    printf("Enter author name: ");
    scanf(" %49[^\n]", books[count].author);

    printf("Enter available copies: ");
    scanf("%d", &books[count].available);

    count++;
    printf("\nBook added successfully!\n");
}

void showBooks() {
    int i;

    printf("\nID   TITLE                 AUTHOR              COPIES\n");
    printf("-----------------------------------------------------\n");

    for (i = 0; i < count; i++) {
        printf("%-4d %-21s %-19s %d\n",
               books[i].id, books[i].title,
               books[i].author, books[i].available);
    }
}

void searchBook() {
    int id, i;

    printf("Enter book ID: ");
    scanf("%d", &id);

    for (i = 0; i < count; i++) {
        if (books[i].id == id) {
            printf("\nTitle: %s\n", books[i].title);
            printf("Author: %s\n", books[i].author);
            printf("Available copies: %d\n", books[i].available);
            return;
        }
    }

    printf("\nBook not found!\n");
}
int main() {
    int choice, id, i;

    books[0] = (struct Book){1, "C Programming", "Dennis Ritchie", 5};
    books[1] = (struct Book){2, "Python Basics", "John Smith", 3};
    books[2] = (struct Book){3, "Data Science", "Alex Brown", 0};

    printf("====================================\n");
    printf("     LIBRARY MANAGEMENT SYSTEM\n");
    printf("====================================\n");

    do {
        printf("\n1. Add New Book\n");
        printf("2. View All Books\n");
        printf("3. Search Book by ID\n");
        printf("4. Check Availability\n");
        printf("5. Exit\n");
        printf("Enter your choice: ");

        if (scanf("%d", &choice) != 1) {
            printf("\nInvalid input! Please enter a number.\n");
            return 0;
        }
        switch (choice) {
            case 1:
                addBook();
                break;

            case 2:
                showBooks();
                break;

            case 3:
                searchBook();
                break;

            case 4:
                printf("Enter book ID: ");
                scanf("%d", &id);

                for (i = 0; i < count; i++) {
                    if (books[i].id == id) {
                        if (books[i].available > 0)
                            printf("Book is AVAILABLE.\n");
                        else
                            printf("Book is NOT AVAILABLE.\n");
                        break;
                    }
                }

                if (i == count)
                    printf("Book not found!\n");
                break;

            case 5:
                printf("\nThank you for using our library!\n");
                break;

            default:
                printf("\nInvalid choice! Try again.\n");
        }

    } while (choice != 5);

    return 0;
}
